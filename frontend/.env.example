# Where the API lives (as seen by the browser). /api goes through the Vite dev proxy.
VITE_API_BASE_URL=/api

# Which features MSW fakes in the browser. Everything else hits the real backend.
#   all | none | comma list of: auth,events,bookings
VITE_MOCKS=all

# Where the Vite dev proxy forwards /api/* (server-side only, not in the bundle).
#   http://localhost:8000 + strip=true  -> FastAPI directly (uvicorn), /api removed like Nginx does
#   http://localhost:80   + strip=false -> your Nginx gateway, which strips /api itself
API_PROXY_TARGET=http://localhost:8000
API_PROXY_STRIP_PREFIX=true

# Demo login for MOCK AUTH ONLY (VITE_* vars are visible in the browser bundle).
VITE_DEMO_EMAIL=demo@ticketrush.dev
VITE_DEMO_PASSWORD=password123
